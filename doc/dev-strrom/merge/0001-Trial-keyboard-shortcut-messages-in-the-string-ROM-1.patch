From 8e798fd86c78743d0afdddecea694285b9a742b1 Mon Sep 17 00:00:00 2001
From: trial <trial@example.invalid>
Date: Wed, 11 Nov 2026 22:38:53 +0100
Subject: [PATCH] Trial: keyboard shortcut messages in the string ROM (#142)

SC$MSG_ADD brackets its copy loop with STRROM$OPEN/STRROM$CLOSE, so that
SC$MSG_START, SC$MSG_ADD, SC$TOAST and SC$TOAST2 accept handles of string
ROM strings. The twelve SC_S_* messages of shortcuts_c64.asm move between
STRROM_BEGIN and STRROM_END. The shortcuts testbed includes strrom.asm.
---
 CORE/m2m-rom/shortcuts_c64.asm   | 7 +++++++
 M2M/rom/shortcuts.asm            | 9 +++++++--
 M2M/rom/strrom.asm               | 2 ++
 M2M/rom/tests/shortcuts_test.asm | 4 ++++
 4 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/CORE/m2m-rom/shortcuts_c64.asm b/CORE/m2m-rom/shortcuts_c64.asm
index 071478a..50ecd72 100644
--- a/CORE/m2m-rom/shortcuts_c64.asm
+++ b/CORE/m2m-rom/shortcuts_c64.asm
@@ -299,6 +299,12 @@ _SCV_DONE       MOVE    0, @R5
                 SYSCALL(leave, 1)
                 RET
 
+; make_rom.sh stores the strings between the markers STRROM_BEGIN and
+; STRROM_END in the string ROM instead of in the firmware ROM (see
+; M2M/rom/strrom.asm). Their labels are handles and not pointers: they are only
+; passed to SC$MSG_START, SC$MSG_ADD, SC$TOAST and SC$TOAST2, directly or via
+; SC_NEXT_MSGS, SC_DRIVE_MSG and SC_DRIVE_START.
+;STRROM_BEGIN
 SC_S_DRIVE      .ASCII_W "Drive "
 SC_S_COLON      .ASCII_W ": "
 SC_S_OFF        .ASCII_W " is off"
@@ -311,3 +317,4 @@ SC_S_FLIPPED    .ASCII_W "flipped"
 SC_S_NORMAL     .ASCII_W "normal"
 SC_S_VOLUME     .ASCII_W "Volume: "
 SC_S_PERCENT    .ASCII_W "%"
+;STRROM_END
diff --git a/M2M/rom/shortcuts.asm b/M2M/rom/shortcuts.asm
index c662b21..8a85ddd 100644
--- a/M2M/rom/shortcuts.asm
+++ b/M2M/rom/shortcuts.asm
@@ -313,7 +313,8 @@ _SCGK_RET       DECRB
 ; SC_TOAST_BUF and SC$MSG_SHOW shows it; SC$TOAST does all of it for one
 ; string and SC$TOAST2 for two strings.
 ;
-; Input:  R8 (and R9 for SC$TOAST2): zero terminated string(s)
+; Input:  R8 (and R9 for SC$TOAST2): zero terminated string(s): pointers or
+;         handles of string ROM strings (strrom.asm)
 ; Output: All registers stay unchanged
 ; ----------------------------------------------------------------------------
 
@@ -341,7 +342,10 @@ _SCMA_END       CMP     0, @R0
                 ADD     1, R0
                 ADD     1, R1
                 RBRA    _SCMA_END, 1
-_SCMA_COPY      MOVE    R8, R2
+_SCMA_COPY      MOVE    R8, R4                  ; R4: R8 of the caller
+                RSUB    STRROM$OPEN, 1          ; R8: pointer to the string
+                MOVE    R8, R2
+                MOVE    R4, R8
 _SCMA_LOOP      CMP     SC_TOAST_LEN, R1        ; buffer full?
                 RBRA    _SCMA_TERM, Z
                 MOVE    @R2++, R3
@@ -350,6 +354,7 @@ _SCMA_LOOP      CMP     SC_TOAST_LEN, R1        ; buffer full?
                 ADD     1, R1
                 RBRA    _SCMA_LOOP, 1
 _SCMA_TERM      MOVE    0, @R0
+                RSUB    STRROM$CLOSE, 1
                 DECRB
                 RET
 
diff --git a/M2M/rom/strrom.asm b/M2M/rom/strrom.asm
index fa164a8..1f3d0b9 100644
--- a/M2M/rom/strrom.asm
+++ b/M2M/rom/strrom.asm
@@ -28,6 +28,8 @@
 ;       LOG_STR                 (tools.asm)
 ;       SCR$PRINTSTR            (screen.asm) and therefore SCR$PRINTSTRXY
 ;       FATAL and FATAL_IDX     (shell.asm)
+;       SC$MSG_START, SC$MSG_ADD (shortcuts.asm) and therefore SC$TOAST and
+;                               SC$TOAST2
 ;
 ; exactly like a pointer to a string. Everything else needs a pointer: the
 ; string functions of the QNICE Monitor (strlen, strcpy, strcmp, strstr, ...),
diff --git a/M2M/rom/tests/shortcuts_test.asm b/M2M/rom/tests/shortcuts_test.asm
index fb43e56..49e46b8 100644
--- a/M2M/rom/tests/shortcuts_test.asm
+++ b/M2M/rom/tests/shortcuts_test.asm
@@ -735,6 +735,10 @@ VD_NEXT_DISK    INCRB                           ; "ND <drive>"
 #include "shortcuts_tbgen_mod.asm"
 #include "shortcuts_tbgen_c64.asm"
 
+; SC$MSG_ADD accepts handles of string ROM strings. RELEASE is not defined
+; here, so the table is empty and every string is an ordinary string.
+#include "../strrom.asm"
+
 ; ----------------------------------------------------------------------------
 ; Test data
 ; ----------------------------------------------------------------------------
