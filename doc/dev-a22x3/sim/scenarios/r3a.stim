# Scenario r3a: F9 (= Next disk drive 8 in the config file) with nothing mounted falls back to
# the file browser; Down, Return: DISK1.D64; then F9: DISK2.D64 with a message
# Every key: hold it 3 ms, then wait for 20 ms without UART or video RAM activity.
# An invisible session that read a key (file browser, error window) ends in HELP_MENU with
# WAIT333MS (busy loop, keyboard disconnected); a session without a key read does not wait, so
# a Next disk message appears right after the mount. A D64 mount takes about 1.6 s (9 us per byte).
set sd_int 1
reset
wait_uart 1500 MHz
wait_quiet 20000 300
dump n_boot
mark C: F9 = Next disk drive 8, nothing mounted: file browser
press 0400 3
wait_uart 1500 Items in current directory
wait_quiet 20000 300
dump n_browser
mark C: Down (the cursor starts on <..>), Return on DISK1.D64
press 0002 3
wait_quiet 20000 500
dump n_cursor
press 0010 3
wait_uart 3000 Mounted disk image for drive #
wait_osm 0 3000
wait_ms 400
dump n_mount1
mark C: F9 = Next disk drive 8: DISK2 expected
press 0400 3
wait_uart 3000 Mounted disk image for drive #
wait_osm 0 3000
wait_osm 1 800
wait_quiet 2000 50
dump n_next2
wait_osm 0 300
wait_quiet 20000 300
end
