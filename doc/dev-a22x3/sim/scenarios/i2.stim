# Scenario i2: the switches MEGA+left = right of the submenu Mouse (issue #190), SD card
# sd/card_full.blk in the bottom tray. Each switch is a single-select item directly behind
# Port n: Amiga and is only visible while that item is selected; a hidden switch keeps its state.
# Every key: hold it 3 ms, then wait until neither the UART nor the video RAM was active for
# 20 ms. Menu bits = flat indices: Port 1: C64 / Amiga 300/301, switch of port 1 302, Port 2:
# C64 / Amiga 304/305, switch of port 2 306, Back of Mouse 308, opener Mouse 297.
# Visibility states of the switches: none, port 1 only, both, port 2 only; each is left once
# with Back and once with Run/Stop.
#   A  Help; Right, Up, Up, Return: Advanced Settings; Right, Up, Up, Return: Mouse (no switch);
#      Right, Return: Back; Return: Mouse; Run/Stop; Return: Mouse; Left, Down, Space: Port 1:
#      Amiga (switch 1 appears, off); Down: switch 1; Space: on; Return: off; Return: on;
#      Right, Return: Back; Return; Run/Stop; Return; Right, Up, Return: Port 2: Amiga (switch 2
#      appears, off); Down: switch 2; Return: on; Space: off; Space: on; Right, Return: Back;
#      Return; Run/Stop; Help closes the menu and saves (300, 301, 302, 304, 305, 306 change)
#   B  Help: Advanced Settings, cursor on Mouse; Return: Mouse (both switches on); Left,
#      Return: Port 1: C64 (switch 1 disappears, bit 302 stays set); Right, Return: Back;
#      Return; Run/Stop; Help closes the menu and saves (300, 301 change)
#   C  Help; Return: Mouse; Left, Down, Space: Port 1: Amiga (switch 1 appears, on); Down:
#      switch 1; Run/Stop; Help closes the menu and saves (300, 301 change)
set sd_int 1
reset
wait_uart 1500 MHz
wait_quiet 20000 300
dump a_boot
mark A: Help opens the menu
press 0080 3
wait_osm 1 300
wait_quiet 20000 500
dump a_menu
mark A: Right, Up, Up, Return: Advanced Settings
press 0008 3
wait_quiet 20000 500
press 0001 3
wait_quiet 20000 500
press 0001 3
wait_quiet 20000 500
dump a_cursor_adv
press 0010 3
wait_quiet 20000 500
dump a_adv
mark A: Right, Up, Up, Return: Mouse, both ports C64, no switch
press 0008 3
wait_quiet 20000 500
press 0001 3
wait_quiet 20000 500
press 0001 3
wait_quiet 20000 500
dump a_cursor_mouse
press 0010 3
wait_quiet 20000 500
dump a_mouse_none
mark A: none visible: Right, Return: Back
press 0008 3
wait_quiet 20000 500
dump a_cursor_back_none
press 0010 3
wait_quiet 20000 500
dump a_adv_back_none
mark A: Return: Mouse
press 0010 3
wait_quiet 20000 500
dump a_mouse_none2
mark A: none visible: Run/Stop
press 0040 3
wait_quiet 20000 500
dump a_adv_rs_none
mark A: Return: Mouse
press 0010 3
wait_quiet 20000 500
dump a_mouse_none3
mark A: Left, Down, Space: Port 1: Amiga
press 0004 3
wait_quiet 20000 500
press 0002 3
wait_quiet 20000 500
dump a_cursor_m1amiga
press 0020 3
wait_quiet 20000 500
dump a_m1amiga
mark A: Down: switch 1
press 0002 3
wait_quiet 20000 500
dump a_cursor_sw1
mark A: Space: switch 1 on
press 0020 3
wait_quiet 20000 500
dump a_sw1_on_space
mark A: Return: switch 1 off
press 0010 3
wait_quiet 20000 500
dump a_sw1_off_return
mark A: Return: switch 1 on
press 0010 3
wait_quiet 20000 500
dump a_sw1_on_return
mark A: port 1 visible: Right, Return: Back
press 0008 3
wait_quiet 20000 500
dump a_cursor_back_s1
press 0010 3
wait_quiet 20000 500
dump a_adv_back_s1
mark A: Return: Mouse
press 0010 3
wait_quiet 20000 500
dump a_mouse_s1
mark A: port 1 visible: Run/Stop
press 0040 3
wait_quiet 20000 500
dump a_adv_rs_s1
mark A: Return: Mouse
press 0010 3
wait_quiet 20000 500
dump a_mouse_s1b
mark A: Right, Up, Return: Port 2: Amiga
press 0008 3
wait_quiet 20000 500
press 0001 3
wait_quiet 20000 500
dump a_cursor_m2amiga
press 0010 3
wait_quiet 20000 500
dump a_m2amiga
mark A: Down: switch 2
press 0002 3
wait_quiet 20000 500
dump a_cursor_sw2
mark A: Return: switch 2 on
press 0010 3
wait_quiet 20000 500
dump a_sw2_on_return
mark A: Space: switch 2 off
press 0020 3
wait_quiet 20000 500
dump a_sw2_off_space
mark A: Space: switch 2 on
press 0020 3
wait_quiet 20000 500
dump a_sw2_on_space
mark A: both visible: Right, Return: Back
press 0008 3
wait_quiet 20000 500
dump a_cursor_back_both
press 0010 3
wait_quiet 20000 500
dump a_adv_back_both
mark A: Return: Mouse
press 0010 3
wait_quiet 20000 500
dump a_mouse_both
mark A: both visible: Run/Stop
press 0040 3
wait_quiet 20000 500
dump a_adv_rs_both
mark A: Help closes the menu
press 0080 3
wait_osm 0 300
wait_quiet 20000 500
dump a_closed
# HELP_MENU ends with WAIT333MS (busy loop): the main loop reads keys again only after it
wait_ms 400
mark B: Help opens the menu again
press 0080 3
wait_osm 1 300
wait_quiet 20000 500
dump b_menu
mark B: Return: Mouse
press 0010 3
wait_quiet 20000 500
dump b_mouse
mark B: Left, Return: Port 1: C64
press 0004 3
wait_quiet 20000 500
dump b_cursor_m1c64
press 0010 3
wait_quiet 20000 500
dump b_m1c64
mark B: port 2 visible: Right, Return: Back
press 0008 3
wait_quiet 20000 500
dump b_cursor_back_s2
press 0010 3
wait_quiet 20000 500
dump b_adv_back_s2
mark B: Return: Mouse
press 0010 3
wait_quiet 20000 500
dump b_mouse_s2
mark B: port 2 visible: Run/Stop
press 0040 3
wait_quiet 20000 500
dump b_adv_rs_s2
mark B: Help closes the menu
press 0080 3
wait_osm 0 300
wait_quiet 20000 500
dump b_closed
# HELP_MENU ends with WAIT333MS (busy loop): the main loop reads keys again only after it
wait_ms 400
mark C: Help opens the menu again
press 0080 3
wait_osm 1 300
wait_quiet 20000 500
dump c_menu
mark C: Return: Mouse
press 0010 3
wait_quiet 20000 500
dump c_mouse
mark C: Left, Down, Space: Port 1: Amiga
press 0004 3
wait_quiet 20000 500
press 0002 3
wait_quiet 20000 500
dump c_cursor_m1amiga
press 0020 3
wait_quiet 20000 500
dump c_m1amiga
mark C: Down: switch 1
press 0002 3
wait_quiet 20000 500
dump c_cursor_sw1
mark C: both visible: Run/Stop
press 0040 3
wait_quiet 20000 500
dump c_adv_rs
mark C: Help closes the menu
press 0080 3
wait_osm 0 300
wait_quiet 20000 500
dump c_closed
# HELP_MENU ends with WAIT333MS (busy loop): the main loop reads keys again only after it
wait_ms 400
end
